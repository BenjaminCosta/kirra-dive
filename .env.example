# Phase two — Google Sheets lead capture.
# Set these as Vercel environment variables. Never commit real values, and
# never expose them with a NEXT_PUBLIC_ prefix: they are read only inside the
# server-side route handler at POST /api/leads.

# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the newlines escaped exactly like this in Vercel:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional but recommended: send the Kirra Dive team an email after Sheets has
# accepted the lead. Configure this through Resend/Vercel; never expose it to
# the browser with a NEXT_PUBLIC_ prefix.
# RESEND_API_KEY=
# LEAD_NOTIFICATION_EMAIL=dive@kirradive.com
# LEAD_NOTIFICATION_FROM=Kirra Dive Leads <leads@kirradive.com>

# Public site URL used for metadata / Open Graph.
# NEXT_PUBLIC_SITE_URL=https://kirradive.com.au
