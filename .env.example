# Phase two — Google Sheets lead capture.
# Set these as Vercel environment variables. Never commit real values, and
# never expose them with a NEXT_PUBLIC_ prefix: they are read only inside the
# server-side route handler at POST /api/leads.

# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Public site URL used for metadata / Open Graph.
# NEXT_PUBLIC_SITE_URL=https://kirradive.com.au
